{
  "name": "@xsd-visualizer/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint not configured yet)\"",
    "fixture:large": "node scripts/generate-large-fixture.mjs",
    "bench:large": "node --expose-gc scripts/bench-large-schema.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
